# Database Configuration
# Use psycopg (not psycopg2) driver: postgresql+psycopg://
DATABASE_URL=postgresql+psycopg://survey:survey@localhost:5432/survey_mvp

# If backend runs in Docker and DB in Docker (use service name 'db')
# DATABASE_URL=postgresql+psycopg://survey:survey@db:5432/survey_mvp

# If using alternate port 5433
# DATABASE_URL=postgresql+psycopg://survey:survey@localhost:5433/survey_mvp

# Application Configuration
ENV=development
